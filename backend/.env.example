NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://localhost:27017/eats-n-bites

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d
JWT_COOKIE_EXPIRES_IN=7

# CORS - Frontend origin
FRONTEND_URL=http://localhost:3000

# Admin Seed (used for first-admin initialization only)
ADMIN_INIT_SECRET=change_this_secret_before_running_seed

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Logging
LOG_LEVEL=debug
